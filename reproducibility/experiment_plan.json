  "calibration": {
    "confidence_level": 0.95,
    "minimum_coverage": 0.05,
    "minimum_accepted": 30,
    "semantic_target_risk": 0.2,
    "provenance_target_risk": 0.01,
    "infeasible_policy": "block public-test execution",
    "semantic_method": "selector_guided_proof_lock"
  },
  "methods": [
    "baseline",
    "provenance_prompt",
    "candidate_menu_prompt",
    "posthoc_verifier",
    "fragment_token_lock_ablation",
    "soft_prefix_bias_1",
    "soft_prefix_bias_3",
    "soft_prefix_bias_5",
    "soft_prefix_bias_10",
    "direct_proof_lock",
    "derivation_proof_lock",
    "selector_guided_proof_lock",
    "risk_controlled_proof_lock"
  ],
  "primary_outcomes": [
    "numeric_answer_accuracy",
    "valid_numeric_response_rate",
    "unsupported_complete_answer_rate",
    "candidate_recall",
    "selection_accuracy_given_candidate_recall",
