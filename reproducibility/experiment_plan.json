    "development_candidate_gate_and_calibration": "FinQA dev",
    "frozen_final_evaluation": "FinQA public test"
  },
  "model": "google/flan-t5-base",
  "model_fine_tuning": false,
  "candidate_selector": {
    "type": "cross-validated safe blend of heuristic and within-question pairwise linear proof ranker",
    "training_split": "train",
    "grouped_cross_validation": "source report/document",
    "path": "models/candidate_selector.json",
    "reference_usage": "candidate correctness labels only",
    "selection_order": "score before frozen candidate bounds",
    "training_objective": "positive proof preferred to 24 strongest within-question negatives",
    "blend_grid": [
      0.0,
      0.05,
      0.1,
      0.15,
      0.2,
      0.25,
      0.3,
      0.35,
      0.4,
      0.45,
