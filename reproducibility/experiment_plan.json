      0.55,
      0.6,
      0.65,
      0.7,
      0.75,
      0.8,
      0.85,
      0.9,
      0.95,
      1.0
    ],
    "tie_rule": "prefer lower learned weight",
    "feature_schema": "proof-family feature set",
    "training_population": "frozen deployment candidate population"
  },
  "seed": 42,
  "numeric_only": true,
  "retrieval_top_k": 48,
  "maximum_direct_candidates": 48,
  "maximum_derived_candidates": 192,
  "maximum_candidates_including_abstention": 241,
