# Python / environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Jupyter / OS / IDE
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# Downloaded benchmark data and model caches
data/raw/*.json
!data/raw/.gitkeep
.cache/
.cache_huggingface/
huggingface_cache/

# Checkpoints and large intermediate outputs
**/.run_state/
results/selector_training_rows.csv
results/rerun/development/predictions.jsonl
validation/engineering_checks/predictions_checkpoint.jsonl

# Environment-specific preflight file
reproducibility/preflight_report.json

# Generated rerun packages should be reviewed before committing
NumGuard-Fin-Rerun-Evidence.zip
NumGuard-Fin-Rerun-Evidence.sha256

# Generic archives/checksums are ignored unless explicitly retained below
*.zip
*.sha256

# Preserved research-history and evidence archives are intentionally versioned
!development_history/*.zip
!development_history/*.sha256
!evidence_archives/*.zip
!evidence_archives/*.sha256
!docs/technical_validation/*.sha256
